# ── Servidor ──
PORT=5000
NODE_ENV=development
TZ=America/Bogota
# Origen permitido del frontend en desarrollo (Vite)
CORS_ORIGIN=http://localhost:5173

# ── Base de datos en la nube (Railway: DATABASE_PUBLIC_URL / proxy TCP). Tiene prioridad sobre DB_* ──
DATABASE_URL=
DB_SSL=false

# ── Base de datos PostgreSQL local (se usa si no hay DATABASE_URL; también es el origen de db:import-legacy) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=power_fitness
DB_USER=postgres
DB_PASSWORD=admin

# ── Seguridad ──
JWT_SECRET=cambia-esta-clave-por-una-larga-y-secreta-de-32-caracteres-o-mas
JWT_EXPIRES_IN=7d
# Clave que debe enviar el puente del lector de huellas (POST /api/checkin/huella)
FINGERPRINT_BRIDGE_KEY=cambia-esta-clave-del-lector

# ── Administrador inicial (npm run db:seed) ──
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@powerfitness.com
ADMIN_PASSWORD=Admin123*
# Contraseña inicial de Caja Fuerte (se guarda como SHA256, compatible con el sistema anterior)
CAJA_FUERTE_PASSWORD=123456

# ── Negocio ──
GYM_NOMBRE=POWER FITNESS
DIAS_ALERTA_VENCIMIENTO=7
STOCK_MINIMO=10
HORAS_ENTRE_CHECKINS=12

# ── Autonomía: tareas automáticas ──
# Revisión diaria de mensualidades (vencidas / por vencer) y stock bajo
JOB_VENCIMIENTOS_CRON=5 0 * * *
# Consolidar automáticamente el mes anterior de Caja Fuerte (día 1 a las 00:30)
JOB_CONSOLIDACION_AUTO=true
# Cierre automático de caja diaria al final del día (false = solo manual, como el sistema anterior)
JOB_CIERRE_CAJA_AUTO=false
JOB_CIERRE_CAJA_CRON=55 23 * * *
# Abrir el navegador (panel + kiosko) al iniciar en producción
ABRIR_NAVEGADOR=true
